{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Signal Launcher",
  "version": "0.1.3",
  "identifier": "com.thesignal.playtest.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "The Signal — Playtest",
      "width": 680,
      "height": 680,
      "minWidth": 560,
      "minHeight": 480,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis"],
    "shortDescription": "Install, update and play The Signal playtest",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser" }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFNTMyRDkzQjc1MzFENTYKUldSV0hWTzNreTFUZnFacjB4NGZFQllEbFdFZi8yVmhJdEk3aVROYWdVdEVueGhhNFpja2VmNTgK",
      "endpoints": ["https://github.com/The-Signals/the-signal-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
